# Public values only. The publishable key is designed to be in the browser;
# RLS is what protects data. Never put a service_role or secret key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# "Spend Roll" on prod, "Spend Roll Dev" on dev. Unset = "Spend Roll".
VITE_APP_NAME=Spend Roll Dev
